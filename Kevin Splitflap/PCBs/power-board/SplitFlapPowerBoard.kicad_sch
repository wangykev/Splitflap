	)
	(text
		"Resettable PTC fuses. Each red LED lights when its output is live; dark = fuse tripped (it resets once cool)."
		(exclude_from_sim no)
		(at 157.48 43.18 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "4fd6311b-435b-4ff3-85ee-016ba1ca56ff")
	)
